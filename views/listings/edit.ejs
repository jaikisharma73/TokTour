<% layout("/layouts/boilerplate")%>

    <div class="pro-form-container">
        <h3 class="pro-form-title">Edit Listing</h3>

        <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation"
            enctype="multipart/form-data">
            <div class="mb-4">
                <label for="title" class="pro-label form-label">Title</label>
                <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control pro-input"
                    required />
                <div class="valid-feedback">Title Looks Good</div>
            </div>

            <div class="mb-4">
                <label for="description" class="pro-label form-label">Description</label>
                <textarea name="listing[description]" class="form-control pro-input pro-textarea"
                    required><%= listing.description %></textarea>
                <div class="invalid-feedback">Please Enter A Short Description</div>
            </div>

            <div class="mb-4">
                <label for="title" class="pro-label form-label">Original Listing Image</label>
                <br>
                <img src="<%= originalImageUrl %>" class="img-fluid"
                    style="max-width: 250px; height: auto; border-radius: 8px;" />
            </div>

            <div class="mb-4">
                <label for="image link" class="pro-label form-label">Upload New Image</label>
                <input name="listing[image]" type="file" class="form-control pro-input" />
            </div>

            <div class="row gx-4">
                <div class="mb-4 col-md-4">
                    <label for="price" class="pro-label form-label">Price (per night)</label>
                    <div class="input-group">
                        <span class="input-group-text"
                            style="border-radius: 12px 0 0 12px; border: 2px solid #e9ecef; border-right: none; background: #f8f9fa;">&#8377;</span>
                        <input name="listing[price]" value="<%= listing.price %>" type="number" min="0"
                            class="form-control pro-input" style="border-radius: 0 12px 12px 0; border-left: none;"
                            required />
                        <div class="invalid-feedback">Price Should Be Valid</div>
                    </div>
                </div>

                <div class="mb-4 col-md-8">
                    <label for="country" class="pro-label form-label">Country</label>
                    <input name="listing[country]" value="<%= listing.country %>" type="text"
                        class="form-control pro-input" required />
                    <div class="invalid-feedback">Country Name Should Be Valid</div>
                </div>
            </div>

            <div class="mb-4">
                <label for="location" class="pro-label form-label">Location (City, State)</label>
                <input name="listing[location]" value="<%= listing.location %>" type="text"
                    class="form-control pro-input" required />
                <div class="invalid-feedback">Location Should Be Valid</div>
            </div>

            <div class="mb-4">
                <label class="pro-label form-label">Filters (Categories)</label>
                <div class="row">
                    <% const allFilters = ["Trending", "Rooms", "City", "Mountains", "SwimmingPool", "Castles", "Camping", "Farms", "Arctic", "Domes", "Boats", "Parks", "Skiing", "Tropical", "Tiny Homes", "Top Views", "Lakefront", "Historical", "B&Bs", "Glamping", "Desert"]; %>
                    <% for(let filter of allFilters) { %>
                    <div class="col-6 col-md-4 col-lg-3 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="listing[filters][]" value="<%= filter %>" id="filter-<%= filter %>" <%= listing.filters && listing.filters.includes(filter) ? "checked" : "" %>>
                            <label class="form-check-label" style="font-size: 0.9rem;" for="filter-<%= filter %>">
                                <%= filter %>
                            </label>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <button class="btn pro-btn pro-btn-primary pro-form-btn">Save Changes</button>
        </form>
    </div>