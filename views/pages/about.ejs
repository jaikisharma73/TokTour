<% layout("/layouts/boilerplate") %>

<div class="pro-index-container pt-5">
    <div class="pro-header">
        <h1 class="pro-page-title mb-4">About TokTour</h1>
        <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 800px;">
            We believe that every journey should be extraordinary. Our mission is to connect travelers with the world's most unique stays and experiences.
        </p>
    </div>

    <div class="row align-items-center mb-5 pb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="pro-glass-panel border-0 shadow-sm">
                <h3 class="fw-bold mb-3" style="color: #1a1a2e;">Our Story</h3>
                <p class="text-muted mb-4" style="line-height: 1.8;">
                    Founded in 2026, TokTour started with a simple idea: making incredible homes accessible to everyone. What began as a small startup has grown into a global community of hosts and travelers who share a passion for exploration and authentic connections.
                </p>
                <p class="text-muted" style="line-height: 1.8;">
                    We carefully curate our listings to ensure that every stay meets our high standards for comfort, design, and uniqueness. Whether you're looking for a cozy cabin in the woods or a modern apartment in the heart of the city, TokTour has something for you.
                </p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="pro-image-wrapper mb-0" style="height: 400px; box-shadow: 0 15px 30px rgba(0,0,0,0.1);">
                <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=2070&auto=format&fit=crop" class="pro-image w-100 h-100" style="object-fit: cover;" alt="About TokTour">
            </div>
        </div>
    </div>

    <div class="row text-center mb-5 pb-4">
        <div class="col-md-4 mb-4 mb-md-0">
            <div class="pro-glass-panel h-100 d-flex flex-column justify-content-center p-4">
                <i class="fa-solid fa-earth-americas mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold">Global Reach</h4>
                <p class="text-muted mb-0">Listings in over 100 countries worldwide.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4 mb-md-0">
            <div class="pro-glass-panel h-100 d-flex flex-column justify-content-center p-4">
                <i class="fa-solid fa-shield-halved mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold">Trusted Platform</h4>
                <p class="text-muted mb-0">Secure payments and verified host profiles.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pro-glass-panel h-100 d-flex flex-column justify-content-center p-4">
                <i class="fa-solid fa-headset mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold">24/7 Support</h4>
                <p class="text-muted mb-0">Our team is always here to help you travel safely.</p>
            </div>
        </div>
    </div>
</div>
