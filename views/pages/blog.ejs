<% layout("/layouts/boilerplate") %>

<div class="pro-index-container pt-5">
    <div class="pro-header">
        <h1 class="pro-page-title mb-3">Travel Blog</h1>
        <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 600px;">
            Stories, tips, and guides from travelers exploring the world with TokTour.
        </p>
    </div>

    <div class="row">
        <!-- Featured Post -->
        <div class="col-12 mb-5">
            <div class="pro-card d-flex flex-column flex-lg-row overflow-hidden border-0 shadow-sm h-100">
                <div class="pro-image-wrapper mb-0 w-100" style="border-radius: 0; min-height: 300px; flex: 1;">
                    <img src="https://images.unsplash.com/photo-1499856871958-5b9627545d1a?q=80&w=2020&auto=format&fit=crop" class="pro-image w-100 h-100" style="object-fit: cover;" alt="Featured Blog Post">
                </div>
                <div class="p-5 d-flex flex-column justify-content-center" style="flex: 1;">
                    <span class="badge mb-3 align-self-start" style="background-color: #fe424d; border-radius: 8px; padding: 0.5rem 1rem;">Destination Guide</span>
                    <h2 class="fw-bold mb-3" style="color: #1a1a2e; font-size: 2rem;">A Weekend in Paris: The Ultimate Itinerary</h2>
                    <p class="text-muted mb-4 fs-5">
                        Discover the hidden gems and iconic landmarks of the City of Light. From secret cafes to the best views of the Eiffel Tower.
                    </p>
                    <div class="d-flex align-items-center justify-content-between mt-auto">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-circle-user fs-3 me-2 text-secondary"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Sarah Jenkins</h6>
                                <small class="text-muted">May 2, 2026 &middot; 5 min read</small>
                            </div>
                        </div>
                        <a href="#" class="btn btn-outline-dark border-0 fw-bold">Read More <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- More Posts -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="pro-card h-100 border-0 shadow-sm">
                <div class="pro-card-img-wrapper" style="padding-top: 60%;">
                    <img src="https://images.unsplash.com/photo-1542259009477-d625272157b7?q=80&w=2069&auto=format&fit=crop" class="pro-card-img" alt="Blog Image">
                </div>
                <div class="pro-card-body p-4">
                    <span class="text-uppercase fw-bold mb-2 d-block" style="color: #fe424d; font-size: 0.8rem;">Travel Tips</span>
                    <h5 class="fw-bold mb-3" style="color: #1a1a2e;">How to Pack Light for a Two-Week Vacation</h5>
                    <p class="text-muted mb-4" style="font-size: 0.95rem;">Master the art of packing with our comprehensive guide to minimalist travel essentials.</p>
                    <div class="mt-auto">
                        <small class="text-muted fw-bold">By Alex River &middot; Apr 28, 2026</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="pro-card h-100 border-0 shadow-sm">
                <div class="pro-card-img-wrapper" style="padding-top: 60%;">
                    <img src="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?q=80&w=2080&auto=format&fit=crop" class="pro-card-img" alt="Blog Image">
                </div>
                <div class="pro-card-body p-4">
                    <span class="text-uppercase fw-bold mb-2 d-block" style="color: #fe424d; font-size: 0.8rem;">Experiences</span>
                    <h5 class="fw-bold mb-3" style="color: #1a1a2e;">Top 10 Secluded Beaches in Southeast Asia</h5>
                    <p class="text-muted mb-4" style="font-size: 0.95rem;">Escape the crowds and discover pristine coastlines that few travelers ever get to see.</p>
                    <div class="mt-auto">
                        <small class="text-muted fw-bold">By Maya Patel &middot; Apr 20, 2026</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="pro-card h-100 border-0 shadow-sm">
                <div class="pro-card-img-wrapper" style="padding-top: 60%;">
                    <img src="https://images.unsplash.com/photo-1518684079-3c830dcef090?q=80&w=1974&auto=format&fit=crop" class="pro-card-img" alt="Blog Image">
                </div>
                <div class="pro-card-body p-4">
                    <span class="text-uppercase fw-bold mb-2 d-block" style="color: #fe424d; font-size: 0.8rem;">Hosting</span>
                    <h5 class="fw-bold mb-3" style="color: #1a1a2e;">A Host's Guide to Welcoming International Guests</h5>
                    <p class="text-muted mb-4" style="font-size: 0.95rem;">Ensure a 5-star experience for travelers from around the world with these simple touches.</p>
                    <div class="mt-auto">
                        <small class="text-muted fw-bold">By David Chen &middot; Apr 15, 2026</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-4 mb-5">
        <button class="btn btn-outline-dark fw-bold px-4 py-2" style="border-radius: 12px;">Load More Articles</button>
    </div>
</div>
