<% layout("/layouts/boilerplate") %>

<div class="pro-index-container pt-5">
    <div class="pro-header text-center mb-5">
        <h1 class="pro-page-title mb-3">Join Our Team</h1>
        <p class="text-muted fs-5 mx-auto" style="max-width: 700px;">
            Help us build the future of travel. We're looking for passionate individuals to join our global team.
        </p>
        <a href="#open-roles" class="btn pro-btn pro-btn-primary mt-3">View Open Roles</a>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="pro-glass-panel border-0 p-5" style="background: linear-gradient(135deg, rgba(254, 66, 77, 0.05) 0%, rgba(255, 107, 107, 0.05) 100%);">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-4 mb-lg-0">
                        <h3 class="fw-bold mb-4" style="color: #1a1a2e;">Why TokTour?</h3>
                        <ul class="list-unstyled">
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fa-solid fa-check-circle mt-1 me-3" style="color: #fe424d; font-size: 1.2rem;"></i>
                                <div>
                                    <h5 class="fw-bold mb-1">Remote-First Culture</h5>
                                    <p class="text-muted mb-0">Work from anywhere in the world. We value flexibility and results.</p>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fa-solid fa-check-circle mt-1 me-3" style="color: #fe424d; font-size: 1.2rem;"></i>
                                <div>
                                    <h5 class="fw-bold mb-1">Travel Credits</h5>
                                    <p class="text-muted mb-0">Generous annual credits to use on TokTour stays to experience our product.</p>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fa-solid fa-check-circle mt-1 me-3" style="color: #fe424d; font-size: 1.2rem;"></i>
                                <div>
                                    <h5 class="fw-bold mb-1">Health & Wellness</h5>
                                    <p class="text-muted mb-0">Comprehensive global health coverage and wellness stipends.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <div class="pro-image-wrapper mb-0" style="border-radius: 16px;">
                            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2070&auto=format&fit=crop" class="pro-image w-100 h-100" style="object-fit: cover;" alt="TokTour Team">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="open-roles" class="mt-5 pt-4">
        <h3 class="fw-bold mb-4 pb-2 border-bottom" style="color: #1a1a2e;">Open Positions</h3>
        
        <div class="pro-card p-4 mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center hover-shadow transition">
            <div>
                <h5 class="fw-bold mb-1">Senior Full Stack Engineer</h5>
                <p class="text-muted mb-2 mb-md-0"><i class="fa-solid fa-location-dot me-2"></i>Remote (Global) &nbsp; | &nbsp; Engineering</p>
            </div>
            <button class="btn btn-outline-dark" style="border-radius: 8px;">Apply Now</button>
        </div>
        
        <div class="pro-card p-4 mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center hover-shadow transition">
            <div>
                <h5 class="fw-bold mb-1">Product Designer (UI/UX)</h5>
                <p class="text-muted mb-2 mb-md-0"><i class="fa-solid fa-location-dot me-2"></i>Remote (Americas) &nbsp; | &nbsp; Design</p>
            </div>
            <button class="btn btn-outline-dark" style="border-radius: 8px;">Apply Now</button>
        </div>

        <div class="pro-card p-4 mb-5 d-flex flex-column flex-md-row justify-content-between align-items-md-center hover-shadow transition">
            <div>
                <h5 class="fw-bold mb-1">Customer Success Specialist</h5>
                <p class="text-muted mb-2 mb-md-0"><i class="fa-solid fa-location-dot me-2"></i>Remote (EMEA) &nbsp; | &nbsp; Support</p>
            </div>
            <button class="btn btn-outline-dark" style="border-radius: 8px;">Apply Now</button>
        </div>
    </div>
</div>
