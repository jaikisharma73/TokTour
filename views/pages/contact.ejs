<% layout("/layouts/boilerplate") %>

<div class="pro-index-container pt-5">
    <div class="pro-header">
        <h1 class="pro-page-title mb-4">Get in Touch</h1>
        <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 600px;">
            Have a question, feedback, or need help with a booking? Our team is here to assist you 24/7.
        </p>
    </div>

    <div class="row gx-5">
        <div class="col-lg-5 mb-5 mb-lg-0">
            <div class="pro-glass-panel border-0 h-100">
                <h3 class="fw-bold mb-4" style="color: #1a1a2e;">Contact Information</h3>
                
                <div class="d-flex align-items-start mb-4">
                    <div class="me-3" style="color: #fe424d; font-size: 1.5rem;">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Headquarters</h5>
                        <p class="text-muted mb-0">Gorakhpur</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="me-3" style="color: #fe424d; font-size: 1.5rem;">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Email Us</h5>
                        <p class="text-muted mb-0">jack912062sharmas@gmail.com</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-5">
                    <div class="me-3" style="color: #fe424d; font-size: 1.5rem;">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Call Us</h5>
                        <p class="text-muted mb-0">+91 7379185718<br>Mon-Fri, 9am - 6pm IST</p>
                    </div>
                </div>

                <h4 class="fw-bold mb-3" style="color: #1a1a2e;">Follow Us</h4>
                <div class="d-flex gap-3">
                    <a href="#" class="btn btn-outline-dark" style="border-radius: 50%; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#" class="btn btn-outline-dark" style="border-radius: 50%; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="btn btn-outline-dark" style="border-radius: 50%; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="pro-form-container m-0 w-100" style="max-width: none;">
                <h3 class="fw-bold mb-4" style="color: #1a1a2e;">Send us a message</h3>
                <form action="/contact" method="GET" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstName" class="pro-label">First Name</label>
                            <input type="text" class="form-control pro-input" id="firstName" placeholder="John" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="lastName" class="pro-label">Last Name</label>
                            <input type="text" class="form-control pro-input" id="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="pro-label">Email Address</label>
                        <input type="email" class="form-control pro-input" id="email" placeholder="john@example.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="subject" class="pro-label">Subject</label>
                        <select class="form-select pro-input" id="subject" required>
                            <option value="" selected disabled>Select a topic</option>
                            <option value="support">Customer Support</option>
                            <option value="booking">Booking Inquiry</option>
                            <option value="host">Hosting Question</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="message" class="pro-label">Message</label>
                        <textarea class="form-control pro-input pro-textarea" id="message" placeholder="How can we help you?" required></textarea>
                    </div>
                    <button type="submit" class="btn pro-btn pro-btn-primary w-100">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</div>
