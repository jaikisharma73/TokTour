<% layout("/layouts/boilerplate") %>

<div class="pro-index-container pt-5">
    <div class="pro-header mb-5 text-center">
        <h1 class="pro-page-title mb-3">Help Center</h1>
        <p class="text-muted fs-5 mx-auto" style="max-width: 600px;">
            How can we help you today? Browse our topics below or contact our team.
        </p>
        
        <div class="mt-4 mx-auto" style="max-width: 600px; position: relative;">
            <input type="text" class="form-control pro-input py-3 px-4" placeholder="Search for articles, topics, or questions..." style="border-radius: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
            <button class="btn border-0 position-absolute end-0 top-50 translate-middle-y me-2" style="color: #fe424d;"><i class="fa-solid fa-magnifying-glass fs-5"></i></button>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="pro-glass-panel h-100 text-center p-4 hover-shadow transition" style="cursor: pointer;">
                <i class="fa-solid fa-suitcase-rolling mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold mb-2">Traveling</h4>
                <p class="text-muted mb-0">Booking stays, managing reservations, and planning trips.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="pro-glass-panel h-100 text-center p-4 hover-shadow transition" style="cursor: pointer;">
                <i class="fa-solid fa-house-user mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold mb-2">Hosting</h4>
                <p class="text-muted mb-0">Creating listings, managing calendars, and welcoming guests.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="pro-glass-panel h-100 text-center p-4 hover-shadow transition" style="cursor: pointer;">
                <i class="fa-solid fa-id-card mb-3" style="font-size: 2.5rem; color: #fe424d;"></i>
                <h4 class="fw-bold mb-2">Your Account</h4>
                <p class="text-muted mb-0">Managing your profile, payment methods, and security settings.</p>
            </div>
        </div>
    </div>

    <div class="pro-glass-panel border-0 p-5 mb-5" style="background: linear-gradient(135deg, #1a1a2e 0%, #111118 100%); border-radius: 20px;">
        <div class="row align-items-center text-white">
            <div class="col-md-8 mb-4 mb-md-0 text-center text-md-start">
                <h3 class="fw-bold mb-2">Need direct assistance?</h3>
                <p class="mb-0 text-light opacity-75">Our support team is available 24/7 to help resolve any issues.</p>
            </div>
            <div class="col-md-4 text-center text-md-end">
                <a href="/contact" class="btn pro-btn pro-btn-primary px-4 py-2">Get Support</a>
            </div>
        </div>
    </div>
</div>
